# ==============================================================================
# Tech Tombola - Production VPS Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in production secrets (generate 32+ char random strings for secrets)
# 3. Start containers:        docker compose up -d --build
# ==============================================================================

# Public HTTP port on host (default: 80)
PORT=80

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=techtombola

# Security Secrets (Must be at least 32 characters long in production)
# You can generate strong keys with: openssl rand -hex 24
JWT_SECRET=replace_with_at_least_32_characters_random_secret_jwt
SESSION_SECRET=replace_with_at_least_32_characters_random_secret_session

# One-Time Super Admin Bootstrap Secret (Optional, min 32 chars)
# Used only during initial Super Admin account creation via POST /api/v1/auth/bootstrap
# Once the Super Admin account is created, you can comment this out or clear it.
SUPER_ADMIN_BOOTSTRAP_SECRET=replace_with_at_least_32_characters_bootstrap_secret

# Application URL & Allowed CORS Origins (Host IP or Domain)
# Example for domain with SSL: https://tombola.example.com
# Example for raw VPS IP:      http://198.51.100.10
APP_URL=http://localhost
CORS_ORIGIN=http://localhost,http://127.0.0.1

# Email Provider Configuration (Optional for development/staging; recommended for live event)
# Supported options: memory | resend
EMAIL_PROVIDER=memory
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@techtombola.internal

# Logging Level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info
