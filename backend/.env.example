NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techtombola
JWT_SECRET=development_jwt_secret_must_be_configured_properly_32chars
SESSION_SECRET=development_session_secret_must_be_configured_properly_32chars
EMAIL_PROVIDER_API_KEY=dummy_key_for_dev
EMAIL_PROVIDER_URL=http://localhost:8025/send
# Set a unique random 32+ character value only for one-time initial Super Admin bootstrap.
# Leave this unset after the first Super Admin account is created.
EMAIL_FROM=noreply@techtombola.internal
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Optional local verification connection; the role needs CREATEDB.
# LOAD_DATABASE_URL=${DATABASE_URL}
# E2E_DATABASE_URL=${DATABASE_URL}

# Optional Linux load qualification CPU sets, chosen from local lscpu topology.
# LOAD_DRIVER_CPUS=4-7
# LOAD_SERVER_CPUS=0-3

# Local isolated restore rehearsal only; requires CREATE DATABASE.
# RESTORE_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/postgres
# RESTORE_ISOLATED=1
